# =============================================================================
# AgentDB - Vector Database Docker Image
# 150x faster vector database with ReasoningBank learning
# =============================================================================

# The version of the pinned packages/agentdb submodule. Declared before the
# first FROM so it is global, and re-declared bare inside each stage that uses
# it (an ARG's value is not inherited into a stage otherwise). The build stage
# asserts this matches package.json and fails the build if it does not, so the
# label below can no longer silently go stale the way the hardcoded
# "2.0.0-alpha" did - a whole major version behind the 3.0.0-alpha.14 the
# submodule actually pinned. The "Build and run the published agentdb image"
# step in .github/workflows/agentdb-docker-test.yml builds this image on every
# PR that touches packages/agentdb/ or this file - which is exactly the set that
# can cause the drift - so a submodule bump that forgets to update this default
# is caught there automatically. That step builds `--target production`, which
# COPYs --from=build, so the assertion runs even though the build stage is not
# the targeted one.
ARG AGENTDB_VERSION=3.0.0-alpha.14

FROM node:20-alpine AS base

# Install system dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    sqlite \
    sqlite-dev \
    bash \
    curl

WORKDIR /app

# =============================================================================
# Dependencies Stage
#
# Production-only tree, for the runtime image. Built on `base` rather than a
# bare node image because the optional native accelerators compile here, and
# they need python3/make/g++/sqlite-dev.
# =============================================================================
FROM base AS dependencies

COPY packages/agentdb/package*.json ./
# --include=optional is already npm's default; it is stated because it is
# load-bearing here. The CLI this image starts statically imports chalk and
# commander, and agentdb declares both under optionalDependencies, not
# dependencies - so anything that turns optional deps off yields an image whose
# entrypoint cannot resolve its first import.
RUN npm install --omit=dev --include=optional

# =============================================================================
# Build Stage
#
# packages/agentdb ships TypeScript only: there is no src/index.js and no
# committed dist/, so the image has to compile the package itself. That needs
# the FULL dependency tree - typescript is a devDependency, which is why the
# production-only install above cannot double as the build environment.
# =============================================================================
FROM base AS build

# Re-declared bare so the global ARG's value is visible in this stage.
ARG AGENTDB_VERSION

COPY packages/agentdb ./

# The build context is the repository ROOT. The root .dockerignore's `dist/`
# pattern is anchored there, so it does NOT match packages/agentdb/dist: a
# developer's local dist/ still travels into the context and lands here, and a
# stale one would let a failed compile below ship as a success. node_modules is
# now covered - the `**/node_modules` pattern added alongside `node_modules/`
# does exclude packages/agentdb/node_modules at every depth - so that half of
# this rm is defence-in-depth rather than load-bearing. It is kept anyway: it
# costs nothing, and it keeps this stage correct if the build context is ever
# assembled by something other than the root .dockerignore.
RUN rm -rf node_modules dist

# Fail loudly if the ARG default has drifted from the pinned submodule, rather
# than publishing an image whose version label lies. Compared against the value
# node itself reports from package.json, which is the same thing the runtime
# resolves.
RUN ACTUAL="$(node -p 'require("./package.json").version')"; \
    if [ "$ACTUAL" != "$AGENTDB_VERSION" ]; then \
        echo "ERROR: AGENTDB_VERSION build arg is '$AGENTDB_VERSION' but packages/agentdb/package.json reports '$ACTUAL'." >&2; \
        echo "Update the ARG AGENTDB_VERSION default in docker/Dockerfile.agentdb to match the pinned submodule." >&2; \
        exit 1; \
    fi; \
    echo "AGENTDB_VERSION verified: $ACTUAL"

# Same install as every job in .github/workflows/agentdb-docker-test.yml:
# --include=optional picks up the native accelerators when the lockfile has
# them for this platform, and the bare retry covers the cases npm refuses with
# that flag.
RUN npm ci --include=optional || npm ci

# `npm run build` cannot succeed with tsconfig.json as it ships. An unscoped
# tsc reports 114 errors - 33 in benchmarks/, 42 in examples/, 39 in tests/ and
# ZERO in src/ - and none of those three directories are in package.json's
# `files`, so the build fails on code this image will never contain. Narrowing
# `include` to the shipped source makes build:ts, copy:schemas and build:browser
# all pass. This is the same technique, verbatim, as the "Scope typecheck to
# shipped source" steps in .github/workflows/agentdb-docker-test.yml; keep the
# two in step. The narrowing lives here rather than in the submodule because the
# submodule is pinned and its fix belongs upstream (ruvnet/agentdb#25).
RUN node -e "const fs = require('fs'); \
    const cfg = JSON.parse(fs.readFileSync('tsconfig.json', 'utf8')); \
    const before = cfg.include; \
    cfg.include = ['src/**/*', 'simulation/**/*', 'simulation/scenarios/**/*']; \
    fs.writeFileSync('tsconfig.json', JSON.stringify(cfg, null, 2)); \
    console.log('tsconfig include was:', JSON.stringify(before)); \
    console.log('tsconfig include now:', JSON.stringify(cfg.include));"

RUN npm run build

# tsconfig sets rootDir "." so src/ emits to dist/src/, and package.json's main
# and bin agree. Assert it here so a layout change fails the build instead of
# producing an image whose CMD points at a file that does not exist - which is
# precisely how the previous `node src/index.js` reached Docker Hub.
RUN test -f dist/src/index.js && test -f dist/src/cli/agentdb-cli.js

# =============================================================================
# Production Stage
# =============================================================================
FROM node:20-alpine AS production

# Re-declared bare so the global ARG's value is visible in this stage too; the
# build stage's re-declaration does not carry across.
ARG AGENTDB_VERSION

RUN apk add --no-cache \
    bash \
    curl \
    sqlite \
    dumb-init

WORKDIR /app

# Ship what package.json's `files` declares - the compiled dist/ (dist/src/ and
# dist/schemas/) plus the manifest - and not the TypeScript sources, which
# nothing in this image can execute. package.json is required at runtime, not
# just for metadata: its "type": "module" is what makes node load the emitted
# .js as ESM. It is taken from the build stage so it is guaranteed to be the
# manifest that dist/ was compiled from.
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./package.json

# Create data directories
RUN mkdir -p /app/data /app/data/agentdb && \
    chmod -R 777 /app/data

# No HEALTHCHECK, deliberately. A healthcheck only runs while a container is
# running, and this image runs no daemon - its default command prints the CLI
# help and exits - so anything we could probe here would describe the image's
# contents rather than the state of a running container. That is the same defect
# as the check being removed (`test -f /app/data/agentdb/health.check`: nothing
# in either repository ever creates that file, so it could never pass). The
# assertion that actually matters - that the entrypoint loads - is worth making
# once, at the right time, and now runs in CI: the docker-test job in
# .github/workflows/agentdb-docker-test.yml builds this image, runs it, and
# requires exit 0.

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
# Was `node src/index.js`. The package has only src/index.ts, so every container
# started from the published image exited 1 with MODULE_NOT_FOUND. This is the
# path package.json's own bin declares. --help is explicit rather than relying
# on the argument-less CLI continuing to print help by default.
CMD ["node", "dist/src/cli/agentdb-cli.js", "--help"]

# Labels
LABEL maintainer="ruv <contact@ruv.io>"
LABEL org.opencontainers.image.title="AgentDB"
LABEL org.opencontainers.image.description="150x faster vector database with ReasoningBank learning"
LABEL org.opencontainers.image.version="${AGENTDB_VERSION}"
LABEL org.opencontainers.image.source="https://github.com/ruvnet/agentic-flow"

# No EXPOSE. agentdb is an embedded/CLI vector database and this image starts no
# server, so it binds no port. The 5432 that stood here is PostgreSQL's.
VOLUME ["/app/data"]
