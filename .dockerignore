# Dependencies
node_modules/
# Bare patterns are ROOT-ANCHORED with no implicit recursion, so the line above
# matches only ./node_modules - verified with a `FROM scratch` + `COPY . /` probe
# of this exact file, in which agentic-flow/node_modules and
# packages/agentdb/node_modules both survived into the build context. `**/` is
# what excludes them at every depth. No Dockerfile built by docker-publish.yml
# COPYs node_modules from the context (only `COPY --from=` stage copies), so this
# is safe for all four images.
**/node_modules
npm-debug.log
yarn-error.log
package-lock.json

# Build outputs
dist/
build/
*.tsbuildinfo

# Test files
coverage/
.nyc_output/
tests/
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.spec.js

# Documentation
docs/
*.md
!README.md

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment
.env
.env.*
!.env.example

# Temporary files
tmp/
temp/
*.log
*.pid
*.seed
*.pid.lock

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Large directories
open-lovable/
.claude-flow/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

